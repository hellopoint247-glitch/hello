rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Public configurations (e.g. owner_config)
    match /public/{docId} {
      allow read, write: if true;
    }

    // Users (Store settings, PIN, theme, categories, balance card configs)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Customers Collection (Contacts)
    match /users/{userId}/contacts/{contactId} {
      allow read, write: if true;
    }

    // Customer Transactions Ledger
    match /users/{userId}/transactions/{transactionId} {
      allow read, write: if true;
    }

    // Recharge requests
    match /users/{userId}/recharge_requests/{requestId} {
      allow read, write: if true;
    }

    // Paybill requests
    match /users/{userId}/paybill_requests/{requestId} {
      allow read, write: if true;
    }

    // Live Chat messages
    match /users/{userId}/chats/{messageId} {
      allow read, write: if true;
    }

    // Cashbook direct entries
    match /users/{userId}/cashbook/{entryId} {
      allow read, write: if true;
    }

    // Pay Bill entries
    match /users/{userId}/paybills/{paybillId} {
      allow read, write: if true;
    }

    // Reminders collection
    match /users/{userId}/reminders/{reminderId} {
      allow read, write: if true;
    }

    // Products (Shop management & Online Store)
    match /users/{userId}/products/{productId} {
      allow read, write: if true;
    }

    // Quick FAQs & Live chat auto reply rules
    match /users/{userId}/quick_faqs/{faqId} {
      allow read, write: if true;
    }

    // Cash-In Agent accounts / SIMs
    match /users/{userId}/cashin_accounts/{accountId} {
      allow read, write: if true;
    }

    // Cash-In Transactions ledger
    match /users/{userId}/cashin_transactions/{transactionId} {
      allow read, write: if true;
    }

    // Signup Requests collection for new customer self-registration
    match /signup_requests/{requestId} {
      allow read, write: if true;
    }
  }
}


